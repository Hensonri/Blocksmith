{
  "name": "blocksmith",
  "version": "0.1.0",
  "description": "Local-first parametric hat-block and hatmaking-tooling studio",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/Hensonri/Blocksmith.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prepare-sites-build.mjs",
    "preview": "vite preview",
    "test": "node --test tests/blocksmith.test.mjs",
    "check": "npm run test && npm run build && npm run test:sites",
    "db:generate": "drizzle-kit generate --config=drizzle.config.mjs",
    "test:sites": "node --test tests/sites-worker.test.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "5.0.4",
    "drizzle-orm": "^0.44.7",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "vite": "6.4.2"
  },
  "displayName": "Blocksmith Online Workshop",
  "devDependencies": {
    "drizzle-kit": "^0.31.6"
  }
}
